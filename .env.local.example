# Copia este archivo a .env.local y llena los valores. .env.local NO se sube a git.

# --- Supabase (Project Settings → API) ---
# URL del proyecto. Pública: se envía al navegador.
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
# Clave "anon". Pública; RLS la limita a leer la vista reporte_publico.
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Clave "service_role". SOLO SERVIDOR. Sin prefijo NEXT_PUBLIC_ a propósito:
# nunca la importes desde un componente ni la subas a ningún lado.
SUPABASE_SERVICE_ROLE_KEY=

# --- MapTiler (Account → API Keys) ---
# Pública: el navegador la usa para cargar las teselas del mapa.
NEXT_PUBLIC_MAPTILER_KEY=

# --- Antispam (opcional, semana 2+) ---
# Cloudflare Turnstile. Vacío = desactivado (útil durante el desarrollo).
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# Secreto de la tarea diaria de mantenimiento (/api/tareas/mantenimiento).
# Vercel lo envía solo como encabezado "Authorization: Bearer <valor>".
# Cualquier cadena aleatoria de 16 caracteres o más: openssl rand -hex 24
CRON_SECRET=
